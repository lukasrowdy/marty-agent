# --- editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- staged trees (.staged-*/) are deliberately still tracked: each becomes a
# branch, then the folder is deleted. Do not add them here until that migration.

# --- Jr runtime state and deploy transcripts (Marty, 2026-09-29, Lukas's yes 12:01 PM): the broker
# writes its logs, heartbeat and status here; the elevated deploy scripts write their transcripts.
jr/broker/logs/
jr/.staged-build/integrated/deploy/logs/
.staged-ntfy/c4_state.json

# --- Full Marty go-live payload: downloaded Claude CLI binaries (231 MB), not source (2026-09-30)
dashboard/.staged-fullmarty-deploy/fullmarty/cli/

# --- Retell agent state: holds agent ids today and would hold the custom-LLM websocket URL
# (which carries the path secret) once setup-brain exists. Never in history (2026-10-03).
tools/.retell-agent-state.json

# Marty mailbox OAuth client JSON and any other local secret files (2026-10-06, Lukas yes)
secrets/
